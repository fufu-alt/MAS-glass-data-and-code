#Z轴拉伸#
#应变输出
variable     midz     equal  "lz"
variable     Lz0      equal  ${midz}
variable     Lz0      equal  49.6119642200796
variable     strainz  equal  "(lz-v_Lz0)/v_Lz0"
#应力输出
variable     stressz  equal "-pzz/10000"
#文件保存
fix          stretch  all  print  100 "${strainz} ${stressz}"  file  stressz-strainz.form  screen no
#每100步输出一次应变和应力的大小
#拉伸过程
fix              11  all  nve
fix              12  all  temp/rescale  5  300  300  5  1.0
fix              13  all  deform  100  z  erate  0.05  remap  x
#每100步拉伸一次模型，每次拉伸的应变=步数*时间步长*erate=100*0.001*0.05=0.005,其中步数*时间步长=时间
dump             5  all  xyz  50  stretch.xyz
dump_modify      5  element Si Al Mg O
run              15000
